# Stage 1: Build React Admin Portal static bundle
FROM node:22-slim AS frontend
WORKDIR /frontend
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json ./
COPY public ./public
COPY src ./src
RUN npm run build

# Stage 2: Compile lightweight zero-dependency Postgres/Vercel env launcher
FROM eclipse-temurin:17-jdk-alpine AS build
WORKDIR /build
COPY src/VercelLauncher.java .
RUN javac --release 17 -d /out VercelLauncher.java

# Stage 3: Minimal stateless OCI runtime for Vercel Functions container images
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

COPY --from=build /out/ /app/
COPY app/qbank-standalone-1.0.0.jar /app/app/qbank-standalone-1.0.0.jar
COPY --from=frontend /frontend/dist /app/portal-dist

RUN addgroup -S qbank && adduser -S -G qbank qbank && chown -R qbank:qbank /app
USER qbank

ENV PORT=80 \
    QBANK_BASE_PATH=/qbank \
    QBANK_STORAGE_DIR=/tmp/qbank-storage \
    QBANK_PORTAL_DIR=/app/portal-dist

EXPOSE 80
ENTRYPOINT ["java", "-cp", "/app", "VercelLauncher"]
