# Vercel Project Environment Variables for QBank Demo
# NEVER commit real secrets; set these in Vercel Project Settings -> Environment Variables.

# Provided automatically when you connect a Vercel Marketplace Postgres DB (Neon / Supabase / Prisma Postgres):
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# Generate two distinct 256-bit Base64 keys (`openssl rand -base64 32`):
QBANK_ENCRYPTION_KEY=
QBANK_SIGNING_KEY=

# Optional machine token for external engine endpoints (/qbank/api/v1/engine/**):
QBANK_ENGINE_TOKEN=
